[
  {
    "name": "theme_info",
    "theme_name": "Teamstore V2",
    "theme_version": "0.1.0",
    "theme_author": "Teamstore",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo"
      },
      {
        "type": "range",
        "id": "logo_height",
        "min": 20,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.logo_height",
        "default": 40
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:labels.background",
            "default": "#F5F5F5"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:labels.foreground",
            "default": "#000000"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:labels.primary_button_background",
            "default": "#FF69B4"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:labels.primary_button_text",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button",
            "label": "t:labels.secondary_button_background",
            "default": "#663399"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "t:labels.secondary_button_text",
            "default": "#FFFFFF"
          }
        ],
        "role": {
          "text": "text",
          "background": "background",
          "links": "text",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "secondary_button",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button"
        }
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
