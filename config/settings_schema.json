[
  {
    "name": "theme_info",
    "theme_name": "Teamstore V2",
    "theme_version": "0.1.0",
    "theme_author": "Teamstore",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_palette",
        "id": "color_palette",
        "default": {
          "background": "#FFFFFF",
          "foreground": "#333333"
        }
      },
      {
        "type": "color",
        "id": "palette_primary_button_background",
        "label": "t:labels.primary_button_background",
        "default": "{{ settings.color_palette.foreground }}"
      },
      {
        "type": "color",
        "id": "palette_secondary_button_background",
        "label": "t:labels.secondary_button_background",
        "default": "{{ settings.color_palette.background }}"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
