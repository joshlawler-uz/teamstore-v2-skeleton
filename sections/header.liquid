<header class="full-width border-b border-foreground/10">
  <div class="grid grid-cols-[var(--content-grid)]">
    <div class="col-start-2 flex items-center justify-between gap-base py-base">
      <div class="flex items-center gap-base">
        {% render 'header-drawer', menu: section.settings.menu %}
        <a href="{{ routes.root_url }}" class="font-heading text-lg font-semibold text-foreground no-underline">
          {{ shop.name }}
        </a>
      </div>

      {% render 'header-nav', menu: section.settings.menu %}

      <div class="flex items-center gap-base">
        {% render 'localization-form', type: 'country' %}
        {% render 'localization-form', type: 'language' %}
        {% render 'search-modal' %}

        {% if shop.customer_accounts_enabled %}
          <shopify-account menu="{{ section.settings.customer_account_menu }}" class="flex items-center text-foreground [&_svg]:h-6 [&_svg]:w-6">
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        {% endif %}

        <a
          href="{{ routes.cart_url }}"
          class="relative flex items-center text-foreground [&_svg]:h-6 [&_svg]:w-6"
          aria-label="{{ 'accessibility.cart' | t }}: {{ cart.item_count }}"
        >
          {{ 'icon-cart.svg' | inline_asset_content }}
          <span
            class="absolute -right-1 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-primary px-1 text-[10px] leading-none text-background {% unless cart.item_count > 0 %}hidden{% endunless %}"
          >
            {{ cart.item_count }}
          </span>
        </a>
      </div>
    </div>
  </div>
</header>

<script src="{{ 'header.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
