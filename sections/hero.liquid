{% comment %}
  Full-width banner: one image, a heading, and one primary call-to-action
  button. The dark overlay and light text are always on (not a setting) so
  the heading stays legible over any photo, reusing the section's own
  --color-foreground/--color-background tokens rather than a hardcoded
  overlay colour — this keeps the overlay correct across colour schemes
  with no extra setting needed.
{% endcomment %}

<div class="color-{{ section.settings.color_scheme }} full-width">
  <div class="relative isolate flex min-h-[28rem] items-center justify-center overflow-hidden md:min-h-[32rem]">
    {% if section.settings.media_type == 'video' and section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          class: 'absolute inset-0 -z-20 h-full w-full object-cover'
      }}
    {% elsif section.settings.image %}
      <picture class="absolute inset-0 -z-20 block h-full w-full">
        {% if section.settings.image_mobile %}
          <source
            media="(max-width: 767px)"
            srcset="
              {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
              {{ section.settings.image_mobile | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
          >
        {% endif %}
        <img
          src="{{ section.settings.image | image_url: width: 2000 }}"
          srcset="
            {{ section.settings.image | image_url: width: 750 }} 750w,
            {{ section.settings.image | image_url: width: 1500 }} 1500w,
            {{ section.settings.image | image_url: width: 2000 }} 2000w
          "
          sizes="100vw"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        >
      </picture>
    {% else %}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'absolute inset-0 -z-20 h-full w-full object-cover' }}
    {% endif %}

    <div class="absolute inset-0 -z-10 bg-foreground/40"></div>

    <div class="relative z-10 flex max-w-2xl flex-col items-center gap-base px-base text-center text-background">
      {% if section.settings.heading != blank %}
        <h1 class="font-heading text-3xl font-semibold md:text-5xl">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="btn btn-primary">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:labels.media_type",
      "options": [
        {
          "value": "image",
          "label": "t:options.media_type.image"
        },
        {
          "value": "video",
          "label": "t:options.media_type.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:labels.image_mobile",
      "info": "t:info.image_mobile",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Welcome to the club store"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
