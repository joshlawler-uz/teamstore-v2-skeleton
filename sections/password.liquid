{% comment %}
  Password-protected store landing page (Settings → Online Store →
  Preferences). The password form is always visible, not hidden behind a
  modal toggle like Horizon's — this is the only way into the store, so it
  stays fully functional with no JavaScript.
{% endcomment %}

<div class="color-{{ section.settings.color_scheme }} full-width">
  <div class="grid grid-cols-[var(--content-grid)] py-base">
    <div class="col-start-2 flex min-h-[28rem] flex-col items-center justify-center gap-base text-center">
      <p class="text-sm font-semibold text-foreground/60">{{ shop.name }}</p>
      <h1 class="font-heading text-3xl font-semibold text-foreground">{{ 'password.title' | t }}</h1>

      {% if shop.password_message != blank %}
        <p class="max-w-xl text-foreground/60">{{ shop.password_message }}</p>
      {% endif %}

      {% form 'storefront_password' %}
        <div class="flex w-full max-w-xs flex-col gap-base">
          {% if form.errors %}
            <div class="text-sm text-foreground" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="flex items-center gap-base">
            <label for="PasswordInput" class="sr-only">{{ 'password.password' | t }}</label>
            <input
              type="password"
              name="password"
              id="PasswordInput"
              autocomplete="current-password"
              {% if form.errors %}
                aria-invalid="true"
              {% endif %}
              class="flex-1 border border-foreground/10 bg-background px-base py-2 text-foreground"
            >
            <button type="submit" class="btn btn-primary">{{ 'password.enter' | t }}</button>
          </div>
        </div>
      {% endform %}

      <div class="mt-base flex flex-col items-center gap-2 border-t border-foreground/10 pt-2 text-sm text-foreground/60">
        <p>{{ 'password.powered_by' | t }}</p>
        <p>{{ 'password.store_owner_link_html' | t: link: '/admin' }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
