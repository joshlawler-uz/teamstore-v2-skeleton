<div class="color-{{ section.settings.color_scheme }} full-width border-t border-foreground/10">
  <div class="grid grid-cols-[var(--content-grid)]">
    <div class="col-start-2 flex flex-col items-center gap-base py-base text-center md:flex-row md:flex-nowrap md:items-start md:justify-between md:text-left">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'menu' %}
            <div class="w-full text-left md:min-w-40 md:flex-1" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <p class="mb-2 font-heading font-semibold text-foreground">{{ block.settings.heading }}</p>
              {% elsif block.settings.menu != blank %}
                <p class="mb-2 font-heading font-semibold text-foreground">{{ block.settings.menu.title }}</p>
              {% endif %}
              <ul role="list" class="flex flex-col items-start gap-2">
                {% for link in block.settings.menu.links %}
                  <li>
                    <a href="{{ link.url }}" class="text-foreground/60 no-underline hover:text-primary">
                      {{ link.title }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>

          {% when 'social-links' %}
            {% liquid
              assign social_links = 'facebook,instagram,x,youtube,tiktok' | split: ','
            %}
            <div class="flex items-center justify-center gap-base md:justify-start" {{ block.shopify_attributes }}>
              {% for platform in social_links %}
                {% assign setting_key = platform | append: '_url' %}
                {% assign url = block.settings[setting_key] %}
                {% if url != blank %}
                  <a
                    href="{{ url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="{{ platform | capitalize }}"
                    class="flex items-center text-foreground/60 hover:text-primary [&_svg]:h-5 [&_svg]:w-5"
                  >
                    {{ 'icon-' | append: platform | append: '.svg' | inline_asset_content }}
                  </a>
                {% endif %}
              {% endfor %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:labels.menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "social-links",
      "name": "t:general.social_links",
      "settings": [
        {
          "type": "url",
          "id": "facebook_url",
          "label": "t:labels.facebook"
        },
        {
          "type": "url",
          "id": "instagram_url",
          "label": "t:labels.instagram"
        },
        {
          "type": "url",
          "id": "x_url",
          "label": "t:labels.x"
        },
        {
          "type": "url",
          "id": "youtube_url",
          "label": "t:labels.youtube"
        },
        {
          "type": "url",
          "id": "tiktok_url",
          "label": "t:labels.tiktok"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:general.footer",
      "blocks": [
        {
          "type": "menu"
        },
        {
          "type": "social-links"
        }
      ]
    }
  ]
}
{% endschema %}
